{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/v10.4.0/cspell.schema.json",
  "version": "0.2",
  "words": ["yarnrc", "rclone", "Tlmc", "prisma", "herdr", "sebastienelet"],
  "language": "en",
  "globRoot": ".",
  "dictionaries": ["user-dictionary", "fr-fr"],
  "ignorePaths": ["node_modules", "dist", "build"],
  "dictionaryDefinitions": [
    {
      "name": "user-dictionary",
      "addWords": true,
      "path": "~/.config/cspell/user.txt"
    }
  ]
}
