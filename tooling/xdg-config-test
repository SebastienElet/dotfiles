#!/usr/bin/env bash
set -euo pipefail

tooling_dir=$(cd "$(dirname "$0")" && pwd)
repository=$(cd "$tooling_dir/.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/xdg-config-test.XXXXXX")
trap 'rm -rf "$test_root"' EXIT
test_home=$test_root/home
fake_bin=$test_root/bin
mkdir -p "$test_home" "$fake_bin"
touch "$fake_bin/brew" "$fake_bin/delta"

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

assert_link() {
  [[ -L $1 ]] || fail "$1 is not a symbolic link"
  [[ $(readlink "$1") == "$2" ]] || fail "$1 has an unexpected source"
}

ln -s "$repository/home/.wezterm.lua" "$test_home/.wezterm.lua"
ln -s "$repository/home/.tmux.conf" "$test_home/.tmux.conf"
ln -s "$repository/home/.gitconfig.delta" "$test_home/.gitconfig.delta"
[[ ! -e $repository/home/.wezterm.lua && ! -L $repository/home/.wezterm.lua ]] || fail "legacy WezTerm source remains"
[[ ! -e $repository/home/.tmux.conf && ! -L $repository/home/.tmux.conf ]] || fail "legacy tmux source remains"
[[ ! -e $repository/home/.gitconfig.delta && ! -L $repository/home/.gitconfig.delta ]] || fail "legacy Git delta source remains"
git config --file "$test_home/.gitconfig" --add include.path '~/.gitconfig.delta'
git config --file "$test_home/.gitconfig" --add include.path '~/.config/git/config.delta'
git config --file "$test_home/.gitconfig" --add include.path '~/.config/git/other.conf'
git config --file "$test_home/.gitconfig" --add include.path '~/xgitconfig.delta'
git config --file "$test_home/.gitconfig" --add include.path '~/.gitconfig.delta'

xdg_targets=(
  "$test_home/.config/wezterm/wezterm.lua"
  "$test_home/.config/tmux/tmux.conf"
  "$test_home/.config/git/config.delta"
)
env HOME="$test_home" make -f "$repository/Makefile" DOTFILES_PATH="$repository" "${xdg_targets[@]}"
assert_link "${xdg_targets[0]}" "$repository/home/.config/wezterm/wezterm.lua"
assert_link "${xdg_targets[1]}" "$repository/home/.config/tmux/tmux.conf"
assert_link "${xdg_targets[2]}" "$repository/home/.config/git/config.delta"
assert_link "$test_home/.wezterm.lua" "$repository/home/.wezterm.lua"
assert_link "$test_home/.tmux.conf" "$repository/home/.tmux.conf"
assert_link "$test_home/.gitconfig.delta" "$repository/home/.gitconfig.delta"

wiring_home=$test_root/wiring-home
mkdir "$wiring_home"
public_targets=(wezterm tmux git-delta)
for index in 0 1 2; do
  expected_target=${xdg_targets[$index]/$test_home/$wiring_home}
  dry_run=$(env HOME="$wiring_home" make -n -f "$repository/Makefile" DOTFILES_PATH="$repository" "${public_targets[$index]}")
  grep -Fq "$expected_target" <<<"$dry_run" || fail "${public_targets[$index]} does not deploy its XDG target"
done

env HOME="$test_home" make -f "$repository/Makefile" DOTFILES_PATH="$repository" BREW_BIN="$fake_bin" git-delta

include_paths=$(git config --file "$test_home/.gitconfig" --get-all include.path)
[[ $(grep -Fxc '~/.config/git/config.delta' <<<"$include_paths") == 1 ]] || fail "Git delta include was not migrated"
[[ $(grep -Fxc '~/.config/git/other.conf' <<<"$include_paths") == 1 ]] || fail "unrelated Git include changed"
[[ $(grep -Fxc '~/xgitconfig.delta' <<<"$include_paths") == 1 ]] || fail "similar Git include changed"
[[ $(grep -Fxc '~/.gitconfig.delta' <<<"$include_paths") == 0 ]] || fail "old Git delta include remains"

config_before=$(cksum "$test_home/.gitconfig")
links_before=$(LC_ALL=C ls -di "${xdg_targets[@]}")
env HOME="$test_home" make -f "$repository/Makefile" DOTFILES_PATH="$repository" BREW_BIN="$fake_bin" git-delta
config_after=$(cksum "$test_home/.gitconfig")
links_after=$(LC_ALL=C ls -di "${xdg_targets[@]}")
[[ $config_before == "$config_after" ]] || fail "Git include migration is not idempotent"
[[ $links_before == "$links_after" ]] || fail "XDG links were redeployed"

real_git=$(command -v git)
git_failure_bin=$test_root/git-failure-bin
mkdir "$git_failure_bin"
printf '%s\n' \
  '#!/usr/bin/env bash' \
  'if [[ $* == "config --global $GIT_FAIL_ARGUMENTS" ]]; then exit 128; fi' \
  'exec "$REAL_GIT" "$@"' >"$git_failure_bin/git"
chmod +x "$git_failure_bin/git"

git config --file "$test_home/.gitconfig" --unset-all include.path '^~/.config/git/config[.]delta$'
git config --file "$test_home/.gitconfig" --add include.path '~/.gitconfig.delta'
config_before=$(cksum "$test_home/.gitconfig")
if env HOME="$test_home" PATH="$git_failure_bin:$PATH" REAL_GIT="$real_git" GIT_FAIL_ARGUMENTS='--add include.path ~/.config/git/config.delta' \
  make -f "$repository/Makefile" DOTFILES_PATH="$repository" BREW_BIN="$fake_bin" git-delta; then
  fail "Git include add failure did not stop the migration"
fi
config_after=$(cksum "$test_home/.gitconfig")
[[ $config_before == "$config_after" ]] || fail "failed Git include addition changed the configuration"

git config --file "$test_home/.gitconfig" --add include.path '~/.config/git/config.delta'
if env HOME="$test_home" PATH="$git_failure_bin:$PATH" REAL_GIT="$real_git" GIT_FAIL_ARGUMENTS="--unset-all include.path ^~/[.]gitconfig[.]delta$" \
  make -f "$repository/Makefile" DOTFILES_PATH="$repository" BREW_BIN="$fake_bin" git-delta; then
  fail "Git include removal failure did not stop the migration"
fi
include_paths=$(git config --file "$test_home/.gitconfig" --get-all include.path)
[[ $(grep -Fxc '~/.config/git/config.delta' <<<"$include_paths") == 1 ]] || fail "failed old include removal lost the new include"
[[ $(grep -Fxc '~/.gitconfig.delta' <<<"$include_paths") == 1 ]] || fail "failed old include removal changed the old include"

config_before=$(cksum "$test_home/.gitconfig")
if env HOME="$test_home" PATH="$git_failure_bin:$PATH" REAL_GIT="$real_git" GIT_FAIL_ARGUMENTS='--get-all include.path' \
  make -f "$repository/Makefile" DOTFILES_PATH="$repository" BREW_BIN="$fake_bin" git-delta; then
  fail "Git include read failure did not stop the migration"
fi
config_after=$(cksum "$test_home/.gitconfig")
[[ $config_before == "$config_after" ]] || fail "failed Git include read changed the configuration"

echo "XDG configuration tests passed"
