#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

main() {
  [[ $# == 3 ]] || fail 'expected arnes, current hook, and legacy hook paths'
  arnes=$1
  runtime_hook=$2
  legacy_hook=$3
  case $arnes:$runtime_hook:$legacy_hook in
  /*:/*:/*) ;;
  *) fail 'hook installation paths must be absolute' ;;
  esac
  [[ -f $arnes && -x $arnes ]] || fail 'arnes must be executable'
  [[ -f $runtime_hook && -x $runtime_hook ]] || fail 'current runtime hook must be executable'
  [[ $runtime_hook != "$legacy_hook" ]] || fail 'legacy runtime hook path must be distinct'
  exec "$arnes" measure install-hooks \
    --agent claude-code \
    --command "$arnes" \
    --claude-stop-command "$runtime_hook" \
    --claude-legacy-stop-command "$legacy_hook"
}

main "$@"
