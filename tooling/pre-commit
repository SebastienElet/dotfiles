#!/usr/bin/env bash
set -e
export PATH="$(git rev-parse --show-toplevel)/.moon/cache/gitleaks:$PATH:/opt/homebrew/bin:/usr/local/bin"
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
exec gitleaks git --staged --config .gitleaks.toml --redact=100 --no-banner --ignore-gitleaks-allow --gitleaks-ignore-path /dev/null
