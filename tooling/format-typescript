#!/usr/bin/env bash
set -euo pipefail

check=false
case "$#:${1:-}" in
  0:)
    ;;
  1:--check)
    check=true
    ;;
  *)
    printf 'Usage: %s [--check]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

typescript_files=$(mktemp)
trap 'rm -f "$typescript_files"' EXIT
git ls-files -z -- '*.ts' '*.tsx' '*.mts' '*.cts' > "$typescript_files"

if [[ ! -s "$typescript_files" ]]; then
  printf 'No tracked TypeScript files found.\n' >&2
  exit 1
fi

if [[ "$check" = true ]]; then
  xargs -0 oxfmt --check -- < "$typescript_files"
else
  xargs -0 oxfmt -- < "$typescript_files"
fi
