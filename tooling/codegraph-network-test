#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
fixture="$root/tooling/codegraph/fixtures/freshness"
probe="$root/tooling/codegraph/mcp_probe.mjs"
canary="$root/tooling/codegraph/network_canary.mjs"
tmp=$(mktemp -d)
repository="$tmp/repository"
network="$tmp/network"
trap 'CODEGRAPH_TELEMETRY=0 CODEGRAPH_NO_UPDATE_CHECK=1 CODEGRAPH_NO_DOWNLOAD=1 codegraph uninit --force "$repository" >/dev/null 2>&1 || true; rm -rf "$tmp"' EXIT

[ "$(uname -s)" = Darwin ] || { echo 'CodeGraph network test requires macOS' >&2; exit 2; }
command -v codegraph >/dev/null 2>&1 || { echo 'codegraph is required' >&2; exit 2; }
command -v git >/dev/null 2>&1 || { echo 'git is required' >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo 'jq is required' >&2; exit 2; }
command -v lsof >/dev/null 2>&1 || { echo 'lsof is required' >&2; exit 2; }
command -v node >/dev/null 2>&1 || { echo 'node is required' >&2; exit 2; }
command -v pgrep >/dev/null 2>&1 || { echo 'pgrep is required' >&2; exit 2; }
lsof -nP -p $$ >/dev/null

collect_pids() {
  frontier=$1
  collected=$1
  while [ -n "$frontier" ]; do
    next=''
    for parent in $frontier; do
      if children=$(pgrep -P "$parent" 2>"$tmp/pgrep-error"); then
        for child in $children; do
          case " $collected " in
            *" $child "*) ;;
            *) collected="$collected $child"; next="$next $child" ;;
          esac
        done
      else
        pgrep_exit=$?
        if [ "$pgrep_exit" -gt 1 ]; then
          cat "$tmp/pgrep-error" >&2
          return 1
        fi
      fi
    done
    frontier=$next
  done
  daemon_file="$repository/.codegraph/daemon.pid"
  if [ -s "$daemon_file" ]; then
    if daemon_pid=$(jq -er .pid "$daemon_file" 2>"$tmp/daemon-error"); then
      collected="$collected $daemon_pid"
    elif [ -e "$daemon_file" ]; then
      cat "$tmp/daemon-error" >&2
      return 1
    fi
  fi
  printf '%s\n' $collected | sort -un
}

sample_process_tree() {
  process_root=$1
  pids=$(collect_pids "$process_root") || return 1
  for process_id in $pids; do
    if lsof -nP -a -p "$process_id" -i >"$tmp/network-sample"; then
      cat "$tmp/network-sample" >>"$network"
      network_violation=1
    else
      lsof_exit=$?
      [ "$lsof_exit" -eq 1 ] || return 1
    fi
  done
}

audit_process() {
  phase=$1
  shift
  network_violation=0
  "$@" >"$tmp/$phase.stdout" 2>"$tmp/$phase.stderr" &
  process_root=$!
  audit_failure=0
  while kill -0 "$process_root" 2>/dev/null; do
    sample_process_tree "$process_root" || audit_failure=1
    sleep 0.05
  done
  sample_process_tree "$process_root" || audit_failure=1
  if wait "$process_root"; then
    process_exit=0
  else
    process_exit=$?
  fi
  if [ "$audit_failure" -ne 0 ]; then
    cat "$tmp/$phase.stderr" >&2
    return 2
  fi
  if [ "$network_violation" -ne 0 ]; then
    cat "$network" >&2
    return 3
  fi
  if [ "$process_exit" -ne 0 ]; then
    cat "$tmp/$phase.stderr" >&2
    return "$process_exit"
  fi
}

: >"$network"
if audit_process canary node "$canary" root 2>"$tmp/canary-sockets"; then
  canary_exit=0
else
  canary_exit=$?
fi
[ "$canary_exit" -eq 3 ] || { echo 'recursive network canary was not detected' >&2; exit 1; }
test -s "$tmp/canary-sockets"
: >"$network"

cp -R "$fixture" "$repository"
git -C "$repository" init -b main >/dev/null
git -C "$repository" config user.email codegraph-fixture@example.invalid
git -C "$repository" config user.name 'CodeGraph Fixture'
git -C "$repository" add .
git -C "$repository" commit -m baseline >/dev/null
git -C "$repository" switch -c codegraph-alt >/dev/null
printf '%s\n' \
  'export const branchAltValue = 30' \
  'export const branchSentinel = "FIXTURE_BRANCH_ALT"' >"$repository/src/branch.ts"
git -C "$repository" add src/branch.ts
git -C "$repository" commit -m alternate >/dev/null
git -C "$repository" switch main >/dev/null

audit_process init env CODEGRAPH_TELEMETRY=0 CODEGRAPH_NO_UPDATE_CHECK=1 CODEGRAPH_NO_DOWNLOAD=1 \
  codegraph init "$repository"
audit_process sync env CODEGRAPH_TELEMETRY=0 CODEGRAPH_NO_UPDATE_CHECK=1 CODEGRAPH_NO_DOWNLOAD=1 \
  codegraph sync "$repository"
audit_process mcp env CODEGRAPH_PROBE_PAUSE_MS=500 node "$probe" "$repository"

test ! -s "$network"
jq -e '.scenarios.daemonStopped == true' "$tmp/mcp.stdout" >/dev/null
jq -n '{sampleIntervalMs: 50, descendantsRecursive: true, phases: {init: true, sync: true, mcp: true}, networkSocketsObserved: 0, daemonStopped: true}'
