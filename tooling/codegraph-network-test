#!/usr/bin/env bun

import { runCodeGraphNetworkTest } from "./codegraph-network-runner.ts";

try {
  process.stdout.write(`${JSON.stringify(await runCodeGraphNetworkTest(), null, 2)}\n`);
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(1);
}
