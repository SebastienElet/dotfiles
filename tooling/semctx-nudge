#!/usr/bin/env bun

import { runSemctxNudge } from "./semctx-nudge.ts";

const result = runSemctxNudge(process.argv.slice(2), await Bun.stdin.text());
if (result.stdout !== undefined) {
  process.stdout.write(result.stdout);
}
if (result.stderr !== undefined) {
  process.stderr.write(`${result.stderr}\n`);
}
