#!/usr/bin/env bash
set -euo pipefail

tooling_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
repository=$(cd "$tooling_dir/.." && pwd)
setup=$tooling_dir/claude-handoff-hook
test_root=$(mktemp -d "${TMPDIR:-/tmp}/claude-handoff-hook.XXXXXX")
trap 'rm -rf "$test_root"' EXIT

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

arnes=$test_root/arnes
runtime=$test_root/agent-handoff
legacy=$test_root/scripts/agent_handoff
trace=$test_root/args
printf '%s\n' '#!/usr/bin/env bash' "printf '%s\\n' \"\$@\" >\"\$TRACE\"" >"$arnes"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$runtime"
chmod +x "$arnes" "$runtime"

TRACE=$trace "$setup" "$arnes" "$runtime" "$legacy"
expected=$test_root/expected
printf '%s\n' \
  measure install-hooks --agent claude-code --command "$arnes" \
  --claude-stop-command "$runtime" --claude-legacy-stop-command "$legacy" >"$expected"
cmp -s "$expected" "$trace" || fail 'Arnes did not receive the owned hook paths'

outside=$test_root/outside
mkdir "$outside"
(cd "$outside" && HOME=$test_root/home make -n -f "$repository/Makefile" \
  DOTFILES_PATH="$repository" LOCAL_BIN="$test_root/bin" claude-handoff-hook) >"$test_root/make"
grep -F -- "$repository/tooling/claude-handoff-hook" "$test_root/make" >/dev/null \
  || fail 'Make target did not resolve the setup source through DOTFILES_PATH'

if "$setup" relative "$runtime" "$legacy" >"$test_root/stdout" 2>"$test_root/stderr"; then
  fail 'relative Arnes path was accepted'
fi

printf 'Claude handoff hook tests passed\n'
