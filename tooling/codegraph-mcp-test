#!/usr/bin/env bun

import { runCodeGraphMcpTest } from "./codegraph-mcp-runner.ts";

try {
  process.stdout.write(`${JSON.stringify(await runCodeGraphMcpTest(), null, 2)}\n`);
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(1);
}
