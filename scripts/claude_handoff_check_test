#!/usr/bin/env bash
# Self-check for scripts/claude_handoff_check.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
hook="$here/claude_handoff_check"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

export XDG_STATE_HOME="$tmp/state"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=100000 # threshold becomes 85000

usage() { # $1 = total context tokens
  printf '{"type":"assistant","message":{"usage":{"input_tokens":2,"cache_read_input_tokens":%s,"cache_creation_input_tokens":0}}}\n' "$(($1 - 2))"
}

run() { # $1 = transcript, $2 = session, $3 = stop_hook_active
  jq -n --arg t "$1" --arg s "$2" --argjson a "$3" \
    '{transcript_path: $t, session_id: $s, stop_hook_active: $a}' | "$hook"
}

low="$tmp/low.jsonl"
usage 40000 >"$low"
high="$tmp/high.jsonl"
usage 90000 >"$high"
sidechain="$tmp/sidechain.jsonl"
usage 40000 >"$sidechain"
printf '{"type":"assistant","isSidechain":true,"message":{"usage":{"input_tokens":90000}}}\n' >>"$sidechain"

[ -z "$(run "$low" s1 false)" ] || {
  echo "FAIL: blocked below threshold" >&2
  exit 1
}
[ -z "$(run "$high" s2 true)" ] || {
  echo "FAIL: blocked while stop_hook_active" >&2
  exit 1
}
[ -z "$(run "$sidechain" s3 false)" ] || {
  echo "FAIL: counted sidechain usage" >&2
  exit 1
}
[ -z "$(run "$tmp/missing.jsonl" s4 false)" ] || {
  echo "FAIL: blocked on unreadable transcript" >&2
  exit 1
}

[ -z "$(env -u CLAUDE_CODE_AUTO_COMPACT_WINDOW "$hook" <<<"$(jq -n --arg t "$high" '{transcript_path: $t, session_id: "s9", stop_hook_active: false}')")" ] || {
  echo "FAIL: guessed a threshold with no window configured" >&2
  exit 1
}

out=$(run "$high" s5 false)
[ "$(printf '%s' "$out" | jq -r .decision)" = "block" ] || {
  echo "FAIL: no block above threshold: $out" >&2
  exit 1
}
[ -z "$(run "$high" s5 false)" ] || {
  echo "FAIL: blocked twice in the same session" >&2
  exit 1
}

echo "ok"
