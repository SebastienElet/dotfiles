#!/usr/bin/env bash
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
hook="$here/agent_handoff"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

export XDG_STATE_HOME="$tmp/state"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=100000

claude_usage() {
  printf '{"type":"assistant","message":{"usage":{"input_tokens":2,"cache_read_input_tokens":%s,"cache_creation_input_tokens":0}}}\n' "$(($1 - 2))"
}

codex_usage() {
  printf '{"type":"event_msg","payload":{"type":"token_count","info":{"last_token_usage":{"input_tokens":%s},"model_context_window":100000,"total_token_usage":{"input_tokens":999999}}}}\n' "$1"
}

run() {
  jq -n --arg t "$1" --arg s "$2" --argjson a "$3" \
    '{transcript_path: $t, session_id: $s, stop_hook_active: $a}' | "$hook"
}

claude_low="$tmp/claude-low.jsonl"
claude_usage 40000 >"$claude_low"
claude_high="$tmp/claude-high.jsonl"
claude_usage 90000 >"$claude_high"
codex_low="$tmp/codex-low.jsonl"
codex_usage 40000 >"$codex_low"
codex_high="$tmp/codex-high.jsonl"
codex_usage 90000 >"$codex_high"
sidechain="$tmp/sidechain.jsonl"
claude_usage 40000 >"$sidechain"
printf '{"type":"assistant","isSidechain":true,"message":{"usage":{"input_tokens":90000}}}\n' >>"$sidechain"

for transcript in "$claude_low" "$codex_low" "$sidechain"; do
  [ -z "$(run "$transcript" "low-$(basename "$transcript")" false)" ] || exit 1
done
[ -z "$(run "$claude_high" active true)" ] || exit 1
[ -z "$(run "$tmp/missing.jsonl" missing false)" ] || exit 1
[ -z "$(env -u CLAUDE_CODE_AUTO_COMPACT_WINDOW "$hook" <<<"$(jq -n --arg t "$claude_high" '{transcript_path: $t, session_id: "no-window", stop_hook_active: false}')")" ] || exit 1

claude_out=$(run "$claude_high" claude false)
[ "$(printf '%s' "$claude_out" | jq -r .decision)" = "block" ] || exit 1
printf '%s' "$claude_out" | jq -e '.reason | contains("/handoff")' >/dev/null

codex_out=$(run "$codex_high" codex false)
[ "$(printf '%s' "$codex_out" | jq -r .decision)" = "block" ] || exit 1
printf '%s' "$codex_out" | jq -e '.reason | contains("$handoff")' >/dev/null
[ -z "$(run "$codex_high" codex false)" ] || exit 1

echo ok
