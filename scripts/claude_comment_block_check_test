#!/usr/bin/env bash
# Self-check for scripts/claude_comment_block_check. Every case below is one
# enumerated way past the check, or one way it could fail to run at all.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
hook="$here/claude_comment_block_check"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

out=''
code=0
fail() {
  echo "FAIL: $1" >&2
  exit 1
}

run() { # $1 = payload, $2 = PATH to run under (optional)
  set +e
  out=$(printf '%s' "$1" | PATH="${2:-$PATH}" "$hook" 2>&1)
  code=$?
  set -e
}

refuses() { # $1 = label, $2 = payload, $3 = expected fragment, $4 = PATH (optional)
  run "$2" "${4:-$PATH}"
  [ "$code" = 2 ] || fail "$1: expected exit 2, got $code: $out"
  case "$out" in
  *"$3"*) ;;
  *) fail "$1: message does not mention '$3': $out" ;;
  esac
}

passes() { # $1 = label, $2 = payload
  run "$2"
  [ "$code" = 0 ] || fail "$1: expected exit 0, got $code: $out"
  [ -z "$out" ] || fail "$1: expected no output, got: $out"
}

written() { # $1 = file_path, $2 = content
  jq -n --arg p "$1" --arg c "$2" \
    '{tool_name: "Write", tool_input: {file_path: $p, content: $c}}'
}

edited() { # $1 = file_path, $2 = old_string, $3 = new_string
  jq -n --arg p "$1" --arg o "$2" --arg n "$3" \
    '{tool_name: "Edit", tool_input: {file_path: $p, old_string: $o, new_string: $n}}'
}

# Markers live in variables so this file holds no literal comment block: the
# check refuses its own fixtures otherwise.
h='#'
s='//'
four=$(printf '%s one\n%s two\n%s three\n%s four\n' "$h" "$h" "$h" "$h")
three=$(printf '%s one\n%s two\n%s three\n' "$h" "$h" "$h")
excused=$(printf '%s Why: the reason is stated here\n%s two\n%s three\n%s four\n' "$h" "$h" "$h" "$h")
slashes=$(printf '%s one\n%s two\n%s three\n%s four\n' "$s" "$s" "$s" "$s")
trailing=$(printf 'a(); %s one\nb(); %s two\nc(); %s three\nd(); %s four\n' "$s" "$s" "$s" "$s")
crlf=$(printf '%s one\r\n%s two\r\n%s three\r\n%s four\r\n' "$h" "$h" "$h" "$h")

refuses "four-line block written" "$(written /r/lint.sh "$four")" 'line 1 of the added text'
refuses "block in a yaml workflow" "$(written /r/.github/workflows/lint.yml "$four")" 'refused'
refuses "slash block in typescript" "$(written /r/src/index.ts "$slashes")" '4-line block'
refuses "block added by an edit" "$(edited /r/lint.sh 'x();' "x();
$four")" '4-line block'
refuses "block written under a path with spaces" "$(written '/r/my dir/lint.sh' "$four")" 'refused'
refuses "block with CRLF line endings" "$(written /r/lint.sh "$crlf")" '4-line block'

passes "three-line block" "$(written /r/lint.sh "$three")"
passes "block whose first line states the reason" "$(written /r/lint.sh "$excused")"
passes "prose is out of scope" "$(written /r/docs/adr/037-x.md "$four")"
passes "trailing comments are not a block" "$(written /r/src/index.ts "$trailing")"
passes "block moved, not added" "$(edited /r/lint.sh "$four" "$four
x();")"
passes "empty edit" "$(edited /r/lint.sh 'x();' '')"

# Known bypass, asserted so it stays visible: the check sees one tool call, so a
# block split across two edits passes. Named in ADR-037.
passes "block split across two edits (known bypass)" "$(edited /r/lint.sh 'x();' "x();
$three")"

refuses "wired to a tool it does not cover" \
  "$(jq -n '{tool_name: "Bash", tool_input: {command: "ls"}}')" 'Edit|Write'
refuses "input without tool_name" "$(jq -n '{tool_input: {file_path: "/r/lint.sh"}}')" 'no tool_name'
refuses "input without file_path" "$(jq -n '{tool_name: "Write", tool_input: {content: "x"}}')" 'file_path'
refuses "write without content" \
  "$(jq -n '{tool_name: "Write", tool_input: {file_path: "/r/lint.sh"}}')" 'tool_input.content'
refuses "edit without new_string" \
  "$(jq -n '{tool_name: "Edit", tool_input: {file_path: "/r/lint.sh", old_string: "x"}}')" 'new_string'
refuses "input that is not JSON" 'not json at all' 'not JSON'

mkdir "$tmp/nojq"
ln -s "$(command -v bash)" "$tmp/nojq/bash"
refuses "jq missing" "$(written /r/lint.sh "$four")" 'jq is missing' "$tmp/nojq"

mkdir "$tmp/badawk"
for tool in bash jq sed mktemp cat rm; do
  ln -s "$(command -v "$tool")" "$tmp/badawk/$tool"
done
printf '%s\nexit 0\n' '#!/bin/sh' >"$tmp/badawk/awk"
chmod +x "$tmp/badawk/awk"
refuses "detector broken" "$(written /r/lint.sh "$four")" 'the detector is broken' "$tmp/badawk"

echo "ok"
