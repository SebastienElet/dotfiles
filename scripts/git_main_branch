#!/usr/bin/env bash

strict=
if [[ ${1-} == "--strict" ]]; then
  strict=1
  shift
fi

# Check if we're in a git repository
if ! command git "$@" rev-parse --git-dir &>/dev/null; then
  if [[ -n $strict ]]; then
    exit 1
  fi
  echo "main"
  exit 0
fi

# Try common branch names that exist locally
for branch in main master trunk; do
  if git "$@" show-ref -q --verify "refs/heads/$branch" 2>/dev/null; then
    echo "$branch"
    exit 0
  else
    show_ref_status=$?
    if [[ $show_ref_status -ne 1 && -n $strict ]]; then
      exit "$show_ref_status"
    fi
  fi
done

# Default to main
echo "main"
