#!/usr/bin/env bash
# Agent hook: an added comment block over three lines is refused unless its
# first line states the reason. Advisory layer, and its output says so, since
# why-versus-what is not machine-decidable. Usage: $0 claude|codex|cursor
set -euo pipefail

LIMIT=3
SEP=$'\001'

die() {
  printf 'comment-block check: %s\n' "$1" >&2
  exit 2
}

command -v jq >/dev/null || die "jq is missing, so nothing was checked."
command -v awk >/dev/null || die "awk is missing, so nothing was checked."

# Each agent keeps unrelated local state in its config, so the entry is merged
# rather than deployed as a symlink. Called by the Makefile, idempotent.
if [ "${1:-}" = --register ]; then
  case "${2:-}" in
  claude) config=$HOME/.claude/settings.json
    add='.hooks.PostToolUse += [{matcher: "Edit|Write", hooks: [{type: "command", command: $cmd}]}]' ;;
  codex) config=$HOME/.codex/hooks.json
    add='.hooks.PostToolUse += [{matcher: "apply_patch", hooks: [{type: "command", command: $cmd}]}]' ;;
  cursor) config=$HOME/.cursor/hooks.json
    add='(.version //= 1) | .hooks.afterFileEdit += [{command: $cmd}]' ;;
  *) printf 'usage: %s --register claude|codex|cursor\n' "$0" >&2; exit 1 ;;
  esac
  cmd="$(cd "$(dirname "$0")" && pwd)/$(basename "$0") $2"
  mkdir -p "$(dirname "$config")"
  [ -f "$config" ] || printf '{}\n' >"$config"
  jq --arg cmd "$cmd" "if [.. | .command? // empty] | index(\$cmd) then . else $add end" \
    "$config" >"$config.new" || {
    rm -f "$config.new"
    printf 'could not rewrite %s\n' "$config" >&2
    exit 1
  }
  cat "$config.new" >"$config"
  rm -f "$config.new"
  exit 0
fi

# Each agent hands the same three values over in a different shape. jq extracts
# path, removed text and added text into one separated record, or refuses.
adapt='
def prose: test("\\.(md|markdown|mdx|txt|rst|adoc|asciidoc|org|tex)$"; "i");
def out($p; $old; $new): "\($p)\u0001\($old)\u0001\($new)";
if $agent == "claude" then
  (.tool_name // error("the input carries no tool_name")) as $t
  | (if $t == "Edit" or $t == "Write" then .
     else error("wired to \($t): set the matcher to Edit|Write") end)
  | (.tool_input.file_path // error("the \($t) input carries no tool_input.file_path")) as $p
  | if $p | prose then out($p; ""; "")
    elif $t == "Write" then
      out($p; ""; .tool_input.content // error("the Write input carries no tool_input.content"))
    else
      out($p; .tool_input.old_string // "";
        .tool_input.new_string // error("the Edit input carries no tool_input.new_string"))
    end
elif $agent == "cursor" then
  (.file_path // error("the afterFileEdit input carries no file_path")) as $p
  | (.edits // error("the afterFileEdit input carries no edits")) as $e
  | if $p | prose then out($p; ""; "")
    else out($p; [$e[].old_string // empty] | join("\n"); [$e[].new_string // empty] | join("\n"))
    end
elif $agent == "codex" then
  if (.tool_name // "") != "apply_patch" then out(""; ""; "")
  else
    ((.tool_input.command // error("the apply_patch input carries no tool_input.command"))
      | if type == "array" then join("\n") else tostring end | split("\n")) as $lines
    | ($lines | map(select(test("^\\*\\*\\* (Add|Update) File: ")))
      | first // "" | sub("^\\*\\*\\* (Add|Update) File: "; "")) as $p
    | if $p | prose then out($p; ""; "")
      else out($p; $lines | map(select(startswith("-"))) | map(.[1:]) | join("\n");
        $lines | map(select(startswith("+"))) | map(.[1:]) | join("\n")) end
  end
else error("unknown agent \"\($agent)\": expected claude, codex or cursor") end'

# Record 2 is the removed text, record 3 the added text: a block present in both
# was moved, not added. The canary refuses when the detector stops detecting.
detect='
function body(l,   b) {
  sub(/\r$/, "", l); sub(/^[ \t]+/, "", l); b = l
  sub(/^(#+|\/\/+|--+|\/\*+|\*\/|\*)[ \t]*/, "", b); sub(/[ \t]*\*\/[ \t]*$/, "", b)
  gsub(/[ \t]+/, " ", b); sub(/^ /, "", b); sub(/ $/, "", b)
  return b
}
function comment(l) {
  sub(/^[ \t]+/, "", l)
  return (l !~ /^#!/) && (l ~ /^#/ || l ~ /^\/\// || l ~ /^--/ || l ~ /^\/\*/ || l ~ /^\*/)
}
function scan(text, added, seen, hits,   lines, i, k, n, first, sig, start) {
  k = split(text, lines, "\n"); n = 0
  for (i = 1; i <= k + 1; i++) {
    if (i <= k && comment(lines[i])) {
      n++
      if (n == 1) { start = i; first = body(lines[i]); sig = first }
      else sig = sig " " body(lines[i])
      continue
    }
    if (n > LIMIT && tolower(first) !~ /^why:/) {
      if (!added) seen[sig] = 1
      else if (!(sig in seen)) hits[++found] = start "\t" n "\t" first
    }
    n = 0
  }
}
BEGIN {
  h = "#"
  probe = h " canary one\n" h " two\n" h " three\n" h " four\ncode()\n" \
    h " Why: exempt\n" h " b\n" h " c\n" h " d\ncode()\n" h " short\n" h " short\n" h " short"
  scan(probe, 1, probe_seen, probe_hits)
  if (found != 1 || probe_hits[1] !~ /\tcanary one$/) {
    print "the detector is broken: the canary produced [" found ": " probe_hits[1] "]" > "/dev/stderr"
    exit 3
  }
  found = 0
  print "canary-ok"
}
NR == 2 { scan($0, 0, seen, hits) }
NR == 3 { scan($0, 1, seen, hits) }
END { for (i = 1; i <= found; i++) print hits[i] }'

IFS= read -r -d '' payload || true
if ! sections=$(printf '%s' "$payload" | jq -j --arg agent "${1:-}" "$adapt" 2>&1); then
  die "$sections"
fi

if ! report=$(printf '%s' "$sections" | awk -v RS="$SEP" -v LIMIT="$LIMIT" "$detect" 2>&1); then
  die "$report"
fi
# An awk that answers without running the program would otherwise read as clean.
[ "${report%%$'\n'*}" = canary-ok ] || die "the detector did not confirm its canary: $report"
report=${report#canary-ok}
report=${report#$'\n'}
[ -n "$report" ] || exit 0

die "refused ${sections%%"$SEP"*}
$(printf '%s\n' "$report" |
  awk -F'\t' '{ printf "  line %s of the added text: %s-line block starting \"%s\"\n", $1, $2, $3 }')
An added comment block over $LIMIT lines must state its reason on its first line,
as \"Why: <reason>\"; otherwise delete it or make the code say it.
This layer is advisory: why-versus-what is not machine-decidable, so passing it is
not evidence that a comment earns its place."
