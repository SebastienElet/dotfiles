#!/usr/bin/env bash
set -euo pipefail

here=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)
setup="$here/claude_handoff_hook"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/claude-handoff-hook.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

runtime="$tmp/runtime hook"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$runtime"
chmod +x "$runtime"

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

use_home() {
  home="$tmp/$1"
  settings="$home/.claude/settings.json"
  mkdir -p "$home/.claude"
}

run_setup() {
  HOME="$home" "$setup" "$runtime"
}

test_creates_settings() {
  use_home creation
  rmdir "$home/.claude"
  run_setup
  jq -e --arg command "$runtime" '
    .hooks.Stop == [{hooks: [{type: "command", command: $command, args: []}]}]
  ' "$settings" >/dev/null
}

test_preserves_unrelated_settings() {
  use_home preservation
  jq -n '{
    keep: true,
    hooks: {Stop: [{matcher: "existing", hooks: [{type: "future", options: {keep: true}}]}]}
  }' >"$settings"
  run_setup
  jq -e --arg command "$runtime" '
    .keep == true
    and .hooks.Stop[0] == {
      matcher: "existing",
      hooks: [{type: "future", options: {keep: true}}]
    }
    and ([.hooks.Stop[]?.hooks[]? | select(.type == "command" and .command == $command)] | length) == 1
  ' "$settings" >/dev/null
}

test_migrates_legacy_entry() {
  use_home migration
  jq -n --arg command "$runtime" '{
    hooks: {Stop: [{hooks: [{
      type: "command",
      command: $command,
      timeout: 5
    }]}]}
  }' >"$settings"
  run_setup
  jq -e --arg command "$runtime" '
    .hooks.Stop == [{hooks: [{
      type: "command",
      command: $command,
      timeout: 5,
      args: []
    }]}]
  ' "$settings" >/dev/null
}

test_is_idempotent() {
  use_home idempotence
  run_setup
  cp "$settings" "$tmp/settings-once.json"
  run_setup
  cmp -s "$tmp/settings-once.json" "$settings" || fail 'second setup changed settings'
}

test_refuses_invalid_json_without_replacing_it() {
  use_home invalid
  printf '{\n' >"$settings"
  cp "$settings" "$tmp/settings-before.json"
  if run_setup 2>"$tmp/invalid.stderr"; then
    fail 'invalid JSON was accepted'
  fi
  cmp -s "$tmp/settings-before.json" "$settings" || fail 'invalid settings were replaced'
}

test_creates_settings
test_preserves_unrelated_settings
test_migrates_legacy_entry
test_is_idempotent
test_refuses_invalid_json_without_replacing_it

printf 'ok\n'
