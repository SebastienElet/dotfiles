#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

validate_requirements() {
  [ "$#" -eq 1 ] || fail 'expected one runtime hook path'
  runtime_hook=$1
  case "$runtime_hook" in
  /*) ;;
  *) fail 'runtime hook path must be absolute' ;;
  esac
  [ -f "$runtime_hook" ] && [ -x "$runtime_hook" ] || fail 'runtime hook must be executable'
  [ -n "${HOME:-}" ] || fail 'HOME is required'
  command -v jq >/dev/null || fail 'jq is required'
}

prepare_write() {
  settings_dir="$HOME/.claude"
  settings="$settings_dir/settings.json"
  umask 077
  mkdir -p "$settings_dir"
  temporary=$(mktemp "$settings.json.XXXXXX")
  trap cleanup EXIT
}

read_settings() {
  if [ -e "$settings" ]; then
    cat "$settings"
  else
    printf '{}\n'
  fi
}

add_hook() {
  read_settings | jq -e --arg command "$runtime_hook" '
    def is_our_hook:
      .type == "command" and .command == $command;
    if type == "object" then . else error("settings must be a JSON object") end
    | .hooks //= {}
    | .hooks.Stop //= []
    | if any(.hooks.Stop[]?.hooks[]?; is_our_hook) then
        (.hooks.Stop[]?.hooks[]?
          | select(is_our_hook)
          | .args) //= []
      else
        .hooks.Stop += [{hooks: [{
          type: "command",
          command: $command,
          args: []
        }]}]
      end
  ' >"$temporary"
}

write_settings() {
  mv "$temporary" "$settings"
  trap - EXIT
}

cleanup() {
  rm -f "$temporary"
}

main() {
  validate_requirements "$@"
  prepare_write
  add_hook
  write_settings
}

main "$@"
