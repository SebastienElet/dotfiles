#!/usr/bin/env bash
# Claude Code Stop hook: hand off to a fresh session instead of letting the
# context be auto-compacted.
#
# Blocks the stop once, so the agent is re-invoked with an instruction to emit a
# resume prompt via the `handoff` skill. Auto-compact stays enabled as a
# backstop: the threshold is deliberately below the auto-compact window.
set -euo pipefail

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat)
transcript=$(printf '%s' "$input" | jq -r '.transcript_path // empty')
session=$(printf '%s' "$input" | jq -r '.session_id // empty')
active=$(printf '%s' "$input" | jq -r '.stop_hook_active // false')

# Already re-invoked by a Stop hook: never block twice in the same turn.
[ "$active" = "true" ] && exit 0
[ -n "$transcript" ] && [ -r "$transcript" ] || exit 0

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/handoff"
sentinel="$state_dir/${session:-unknown}"
# The context stays full after the handoff; without this the hook would block
# every subsequent turn forever.
[ -f "$sentinel" ] && exit 0

# Context usage as the status line computes it, from the most recent main-chain
# assistant message. Sidechain (subagent) messages have their own context.
used=$(tail -n 500 "$transcript" | jq -R '
  fromjson? // empty
  | select(.type == "assistant" and (.isSidechain | not) and .message.usage)
  | .message.usage
  | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)
' 2>/dev/null | tail -n 1) || true
case "$used" in
'' | *[!0-9]*) exit 0 ;;
esac

# Auto-compact fires at roughly window - 20k (reserved output) - 13k, i.e. ~94%
# of the window. 85% leaves enough room for one more turn before that.
window=${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-}
threshold=${HANDOFF_TOKEN_THRESHOLD:-}
if [ -z "$threshold" ]; then
  # Without a known window the model's real limit is unknown, and guessing one
  # would hand off far too early. Stay silent instead.
  [ -n "$window" ] || exit 0
  threshold=$((window * 85 / 100))
fi
[ "$used" -ge "$threshold" ] || exit 0

mkdir -p "$state_dir"
touch "$sentinel"

jq -n --arg used "$((used / 1000))" --arg limit "$((threshold / 1000))" '{
  decision: "block",
  reason: ("Context is at \($used)k tokens, past the \($limit)k handoff threshold. "
    + "Start no new work. Use the `handoff` skill to emit the resume prompt for a "
    + "fresh session, then stop.")
}'
